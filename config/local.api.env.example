# Local API runtime defaults (for scripts/local-api-dev.sh)

RUST_BACKTRACE=1
HDROP_PORT=8080
PROMETHEUS_PORT=3001
CORS_ORIGIN=*
SINGLE_FILE_LIMIT_MB=500

STORAGE_PROVIDER=s3
S3_REGION=eu-west-1
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_BUCKET_NAME=hdrop
S3_PUBLIC_URL=http://localhost:4566/hdrop

DATABASE_URL=postgres://postgres:postgres@localhost:5432/hdrop

CACHE_STRATEGY=memory
CACHE_MEMORY_LIMIT_MB=100
CACHE_DISK_LIMIT_MB=100
CACHE_DIR=/tmp/hdrop-cache
