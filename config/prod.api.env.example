# Production API runtime defaults

RUST_BACKTRACE=1
HDROP_PORT=80
PROMETHEUS_PORT=3001
CORS_ORIGIN=https://hdrop.example.com
SINGLE_FILE_LIMIT_MB=500

STORAGE_PROVIDER=s3
S3_REGION=eu-west-1
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=hdrop
S3_PUBLIC_URL=https://storage.example.com

DATABASE_URL=postgres://replace-me:replace-me@db.example.com:5432/hdrop

CACHE_STRATEGY=memory
CACHE_MEMORY_LIMIT_MB=4000
CACHE_DISK_LIMIT_MB=4000
CACHE_DIR=/tmp/hdrop-cache
