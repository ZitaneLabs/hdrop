# Single VPS defaults (domain mode with automatic TLS via Caddy)
# Copy to config/vps.compose.env and edit values.
#
# IP bootstrap mode (HTTP only) example values:
# SITE_ADDRESS=:80
# NEXT_PUBLIC_WEB_BASE_URL=http://<server-ip>
# NEXT_PUBLIC_API_BASE_URL=http://<server-ip>/api
# CORS_ORIGIN=http://<server-ip>

WEB_IMAGE=hdrop-web:vps
API_IMAGE=hdrop-api:vps
CADDY_IMAGE=caddy:2-alpine
HTTP_PORT=80
HTTPS_PORT=443
PROMETHEUS_PORT=9090
# Enable for IPv6-only hosts to auto-include infra/compose.vps.ipv6.yml.
VPS_IPV6_ONLY=0
# Build network used by the IPv6 overlay.
VPS_BUILD_NETWORK=host

SITE_ADDRESS=example.com
ACME_EMAIL=you@example.com

# Frontend env baked into the VPS web image at build time.
# After changing these values, rerun `make vps-up` or `make vps-upstall`.
NEXT_PUBLIC_APP_NAME=hdrop
NEXT_PUBLIC_WEB_BASE_URL=https://example.com
NEXT_PUBLIC_API_BASE_URL=https://example.com/api
NEXT_PUBLIC_PBKDF2_ITERATIONS=600000
NEXT_PUBLIC_PASSWORD_BYTES=32
NEXT_PUBLIC_CHALLENGE_BYTES=32

HDROP_PORT=80
HDROP_PROMETHEUS_PORT=3001
CORS_ORIGIN=https://example.com
SINGLE_FILE_LIMIT_MB=500

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/var/lib/hdrop/storage
LOCAL_STORAGE_LIMIT_MB=

POSTGRES_USER=hdrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hdrop
DATABASE_URL=postgres://hdrop:change-me@postgres:5432/hdrop

CACHE_STRATEGY=memory
CACHE_MEMORY_LIMIT_MB=2000
CACHE_DISK_LIMIT_MB=2000
CACHE_DIR=/tmp/hdrop-cache

SMOKE_WEB_URL=https://example.com
SMOKE_API_STATUS_URL=https://example.com/api/status
