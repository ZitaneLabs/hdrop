# Local compose defaults

WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
LOCALSTACK_EDGE_PORT=4567
PROMETHEUS_PORT=9090

NEXT_PUBLIC_APP_NAME=hdrop
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_PBKDF2_ITERATIONS=600000
NEXT_PUBLIC_PASSWORD_BYTES=32
NEXT_PUBLIC_CHALLENGE_BYTES=32
CHOKIDAR_USEPOLLING=true

HDROP_PORT=80
HDROP_PROMETHEUS_PORT=3001
CORS_ORIGIN=*
SINGLE_FILE_LIMIT_MB=500

STORAGE_PROVIDER=s3
S3_REGION=eu-west-1
S3_ENDPOINT=http://localstack:4566
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_BUCKET_NAME=hdrop
S3_PUBLIC_URL=http://localhost:4566/hdrop

DATABASE_URL=postgres://postgres:postgres@postgres:5432/hdrop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hdrop

CACHE_STRATEGY=memory
CACHE_MEMORY_LIMIT_MB=2000
CACHE_DISK_LIMIT_MB=2000
CACHE_DIR=/tmp/hdrop-cache
