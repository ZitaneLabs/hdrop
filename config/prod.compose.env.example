# Production compose defaults

WEB_IMAGE=registry.example.com/hdrop-web:latest
API_IMAGE=registry.example.com/hdrop-api:latest
WEB_PORT=80
API_PORT=8080
PROMETHEUS_PORT=9090

# Frontend env baked into the production web image at build time.
# After changing these values, rerun `make deploy-build`.
NEXT_PUBLIC_APP_NAME=hdrop
NEXT_PUBLIC_WEB_BASE_URL=https://hdrop.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.hdrop.example.com
NEXT_PUBLIC_PBKDF2_ITERATIONS=600000
NEXT_PUBLIC_PASSWORD_BYTES=32
NEXT_PUBLIC_CHALLENGE_BYTES=32

HDROP_PORT=80
HDROP_PROMETHEUS_PORT=3001
CORS_ORIGIN=https://hdrop.example.com
SINGLE_FILE_LIMIT_MB=500

STORAGE_PROVIDER=s3
S3_REGION=eu-west-1
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=hdrop
S3_PUBLIC_URL=https://storage.example.com

DATABASE_URL=postgres://replace-me:replace-me@db.example.com:5432/hdrop

CACHE_STRATEGY=memory
CACHE_MEMORY_LIMIT_MB=4000
CACHE_DISK_LIMIT_MB=4000
CACHE_DIR=/tmp/hdrop-cache
